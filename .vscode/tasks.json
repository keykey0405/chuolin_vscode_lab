{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",//本来是"type": "cppbuild",豆包说问题只出在 VSCode tasks.json 的 cppbuild 任务类型，它会偷偷把参数改掉，只编译当前打开的单个文件
      "label": "C/C++: g++ 生成活动文件 ",
      "command": "C:/mingw64/bin/g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-finput-charset=UTF-8",
        "-fexec-charset=UTF-8",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "编译器: C:/mingw64/bin/g++.exe（只编译当前打开的文件，适合单文件练习）"
    },
    {
      "type": "process",
      "label": "C/C++: g++ 生成全部源文件（多文件工程）",
      "command": "C:/mingw64/bin/g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-finput-charset=UTF-8",
        "-fexec-charset=UTF-8",
        "${workspaceFolder}/demo/multiple_demo/main.cpp",//不写成*cpp，我电脑老报
        "${workspaceFolder}/demo/multiple_demo/mathutil.cpp",
        "-o",
        "${workspaceFolder}/demo/multiple_demo/main.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "detail": "把工作区里所有 .cpp 一起编译成 main.exe（通配符由 gcc 自己展开）。用 type: process 而不是 shell：VS Code 直接把参数交给编译器，不经过 PowerShell/cmd 解析，所以工程路径里带括号（例如 (C++)）或空格也不会被拆坏。若一定要用 type: shell，则 args 里的路径必须自己写成 \"\\\"${workspaceFolder}/*.cpp\\\"\" 这种带转义引号的形式"
    },
    {
      "type": "shell",
      "label": "C/C++: gcc 生成活动文件（C 语言）",
      "command": "C:/mingw64/bin/gcc.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "-std=c17",
        "-Wall",
        "-Wextra",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "detail": "编译器: C:/mingw64/bin/gcc.exe（写 .c 文件时用这个）"
    }
  ]
}
